{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucitelsky-rozcestnik",
  "main": "worker/auth.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "node scripts/build-protected-site.mjs"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "TRUST_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TRUST_INBOX",
        "class_name": "TrustInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "trust-inbox-v1",
      "new_sqlite_classes": [
        "TrustInbox"
      ]
    }
  ]
}
