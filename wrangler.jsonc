{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucitelsky-rozcestnik",
  "main": "worker/auth.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node scripts/build-protected-site.mjs" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [{
    "name": "LOGIN_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 20, "period": 60 }
  }]
}
